	-rm -f ./$(DEPDIR)/regposerr.Po
	-rm -f ./$(DEPDIR)/regposix.Po
	-rm -f ./$(DEPDIR)/regsyntax.Po
	-rm -f ./$(DEPDIR)/regtrav.Po
	-rm -f ./$(DEPDIR)/regversion.Po
	-rm -f ./$(DEPDIR)/st.Po
	-rm -f ./$(DEPDIR)/unicode.Po
	-rm -f ./$(DEPDIR)/us_ascii.Po
	-rm -f ./$(DEPDIR)/utf_16be.Po
