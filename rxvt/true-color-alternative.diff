     int             r, g, b;
@@ -190,6 +192,39 @@ void            rxvtlib_get_truecolor_pixels (rxvtlib *o)
             }
 }
 
+#else
+
+#define TRUECOLOR_CACHE_SIZE    256
+
+static struct {
+    unsigned long   pixel;
+    int             rgb;
+    char            valid;
+} truecolor_cache[TRUECOLOR_CACHE_SIZE];
+
+unsigned long   rxvtlib_get_truecolor_pixel (rxvtlib *o, int rgb)
+{E_
+    XColor          xcol;
+    int             slot = rgb & (TRUECOLOR_CACHE_SIZE - 1);
+
+    if (truecolor_cache[slot].valid && truecolor_cache[slot].rgb == rgb)
+        return truecolor_cache[slot].pixel;
+
+    xcol.red = (unsigned short) (((rgb >> 16) & 0xff) * 257);
+    xcol.green = (unsigned short) (((rgb >> 8) & 0xff) * 257);
+    xcol.blue = (unsigned short) ((rgb & 0xff) * 257);
+    xcol.flags = DoRed | DoGreen | DoBlue;
+    if (!XAllocColor (o->Xdisplay, o->Xcmap, &xcol))
+        xcol.pixel = o->PixColors[Color_bg];
+
+    truecolor_cache[slot].valid = 1;
+    truecolor_cache[slot].rgb = rgb;
+    truecolor_cache[slot].pixel = xcol.pixel;
+    return xcol.pixel;
+}
+
+#endif
